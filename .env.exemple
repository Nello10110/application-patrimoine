# Gabarit des secrets d'exploitation. Copier en `.env` à côté du compose, puis
# remplacer les valeurs. Le `.env` réel est ignoré par git (cf. `.gitignore`) —
# ne JAMAIS écrire ces valeurs dans un `compose-*.yaml`, qui est versionné et
# poussé sur le dépôt distant. Ne jamais faire transiter ces valeurs par un canal
# tiers — messagerie, ticket, conversation avec un assistant : une clé transmise
# est une clé à regénérer.
#
# PATRIMOINE_BACKUP_KEY, à générer sur la machine qui héberge l'application :
#
#   openssl rand -base64 48
#
# Deux formes acceptées (cf. `services/cles_chiffrement.py`) :
#   - une clé Fernet (44 caractères base64 url-safe terminés par « = ») ;
#   - toute phrase secrète d'au moins 32 caractères, dérivée automatiquement.
#
# ATTENTION : cette clé ne se change pas impunément. La modifier rend illisibles
# toutes les sauvegardes chiffrées déjà produites. À conserver aussi précieusement
# que les données elles-mêmes.

# Chiffrement des sauvegardes planifiées (job `sauvegarde_chiffree`).
PATRIMOINE_BACKUP_KEY=

# Connexion SSO/OIDC (facultative — cf. docs/MANUEL_EXPLOITATION.md § 12.1).
# Laisser PATRIMOINE_OIDC_ENABLED vide/à "false" désactive le bouton de connexion
# sans erreur. Les 5 variables suivantes sont obligatoires si activée.
PATRIMOINE_OIDC_ENABLED=false
PATRIMOINE_OIDC_ISSUER=
PATRIMOINE_OIDC_CLIENT_ID=
PATRIMOINE_OIDC_CLIENT_SECRET=
PATRIMOINE_OIDC_REDIRECT_URI=
PATRIMOINE_OIDC_FRONTEND_URL=
# Facultatives : texte du bouton de connexion, mapping des claims OIDC (défauts
# preferred_username/email/name si laissées vides).
PATRIMOINE_OIDC_DISPLAY_NAME=
PATRIMOINE_OIDC_CLAIM_USERNAME=
PATRIMOINE_OIDC_CLAIM_EMAIL=
PATRIMOINE_OIDC_CLAIM_NOM=
