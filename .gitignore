node_modules/
venv/
__pycache__/
*.pyc
*.db
*.db-shm
*.db-wal
dist/
.pytest_cache/
.coverage
htmlcov/

# Sauvegardes locales de la base (contiennent tes données financières)
backend/sauvegardes/

# Sortie générée par l'outil graphify (graphe de code régénérable, cf. graphify-out/manifest.json)
graphify-out/

# Suite E2E Playwright (frontend/e2e) : base seedée jetable + rapports générés à
# chaque run, jamais versionnés.
frontend/e2e/.e2e-data/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Secrets d'exploitation (cles de chiffrement des sauvegardes et du SSO). Les
# compose-*.yaml les lisent depuis un .env voisin plutot que de les porter en dur :
# ces fichiers-la sont versionnes, un secret colle dedans partirait sur le depot
# distant au commit suivant (constate le 03/09/2026).
.env
.env.*
!.env.exemple
